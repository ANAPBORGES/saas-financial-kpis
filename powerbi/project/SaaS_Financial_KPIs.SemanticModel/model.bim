          {
            "name": "is_profitable",
            "dataType": "boolean",
            "sourceColumn": "is_profitable",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "\"TRUE\";;\"FALSE\""
          },
          {
            "name": "margin_pct",
            "dataType": "double",
            "sourceColumn": "margin_pct",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0.0%"
          },
          {
            "name": "discount_tier",
            "dataType": "string",
            "sourceColumn": "discount_tier",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "sortByColumn": "discount_tier_sort"
          },
          {
            "name": "discount_tier_sort",
            "dataType": "int64",
            "sourceColumn": "discount_tier_sort",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "fact_orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Selected = Table.SelectColumns(src_superstore, {",
                "        \"Order ID\", \"Order Date\", \"Ship Date\", \"Ship Mode\", \"Customer ID\",",
                "        \"Product ID\", \"Country\", \"State\", \"City\", \"Postal Code\",",
                "        \"Sales\", \"Quantity\", \"Discount\", \"Profit\"}),",
                "    AddGeoKey = Table.AddColumn(Selected, \"geo_key\",",
                "        each Text.Combine({[Country], [State], [City], [Postal Code]}, \"|\"), type text),",
                "    AddDaysToShip = Table.AddColumn(AddGeoKey, \"days_to_ship\",",
                "        each Duration.Days([Ship Date] - [Order Date]), Int64.Type),",
                "    AddIsProfitable = Table.AddColumn(AddDaysToShip, \"is_profitable\",",
                "        each [Profit] > 0, type logical),",
                "    AddMarginPct = Table.AddColumn(AddIsProfitable, \"margin_pct\",",
                "        each if [Sales] = 0 then 0 else [Profit] / [Sales], type number),",
                "    AddDiscountTier = Table.AddColumn(AddMarginPct, \"discount_tier\",",
                "        each if [Discount] = 0 then \"No discount\"",
                "             else if [Discount] <= 0.1 then \"1-10%\"",
                "             else if [Discount] <= 0.2 then \"11-20%\"",
                "             else if [Discount] <= 0.3 then \"21-30%\"",
                "             else \"Over 30%\", type text),",
                "    AddDiscountTierSort = Table.AddColumn(AddDiscountTier, \"discount_tier_sort\",",
                "        each if [Discount] = 0 then 0",
                "             else if [Discount] <= 0.1 then 1",
                "             else if [Discount] <= 0.2 then 2",
                "             else if [Discount] <= 0.3 then 3",
                "             else 4, Int64.Type),",
                "    Renamed = Table.RenameColumns(AddDiscountTierSort, {",
                "        {\"Order ID\", \"order_id\"}, {\"Order Date\", \"order_date\"}, {\"Ship Date\", \"ship_date\"},",
                "        {\"Ship Mode\", \"ship_mode\"}, {\"Customer ID\", \"customer_id\"}, {\"Product ID\", \"product_id\"},",
                "        {\"Sales\", \"sales\"}, {\"Quantity\", \"quantity\"}, {\"Discount\", \"discount\"}, {\"Profit\", \"profit\"}}),",
                "    Final = Table.SelectColumns(Renamed, {",
                "        \"order_id\", \"order_date\", \"ship_date\", \"ship_mode\", \"customer_id\", \"product_id\",",
                "        \"geo_key\", \"sales\", \"quantity\", \"discount\", \"profit\",",
                "        \"days_to_ship\", \"is_profitable\", \"margin_pct\", \"discount_tier\", \"discount_tier_sort\"})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(fact_orders[sales])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(fact_orders[profit])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Profit Margin %",
            "expression": "DIVIDE([Total Profit], [Total Revenue], 0)",
            "formatString": "0.0%",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(fact_orders[order_id])",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total Customers",
            "expression": "DISTINCTCOUNT(fact_orders[customer_id])",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE([Total Revenue], [Total Orders], 0)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Total Quantity",
            "expression": "SUM(fact_orders[quantity])",
            "formatString": "#,0",
            "displayFolder": "1 Core"
          },
          {
            "name": "Avg Discount",
            "expression": "AVERAGE(fact_orders[discount])",
            "formatString": "0.0%",
            "displayFolder": "1 Core"
          },
          {
            "name": "Revenue YoY %",
            "expression": [
              "VAR CurrentRevenue = [Total Revenue]",
              "VAR PriorRevenue =",
              "    CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[Date]))",
              "RETURN",
              "    IF(",
              "        ISBLANK(PriorRevenue) || PriorRevenue = 0,",
              "        BLANK(),",
              "        DIVIDE(CurrentRevenue - PriorRevenue, PriorRevenue)",
              "    )"
            ],
            "formatString": "0.0%",
            "displayFolder": "2 Time Intelligence"
          },
          {
            "name": "Revenue YoY Abs",
            "expression": [
              "VAR PriorRevenue =",
              "    CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[Date]))",
              "RETURN [Total Revenue] - PriorRevenue"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "2 Time Intelligence"
          },
          {
            "name": "Revenue Rolling 3M",
            "expression": [
              "CALCULATE(",
              "    [Total Revenue],",
              "    DATESINPERIOD(dim_date[Date], LASTDATE(dim_date[Date]), -3, MONTH)",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "2 Time Intelligence"
          },
          {
            "name": "Revenue YTD",
            "expression": "CALCULATE([Total Revenue], DATESYTD(dim_date[Date]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "2 Time Intelligence"
          },
          {
            "name": "Revenue YTD Prior Year",
            "expression": "CALCULATE([Revenue YTD], SAMEPERIODLASTYEAR(dim_date[Date]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "2 Time Intelligence"
          },
          {
            "name": "Revenue YTD vs PY %",
            "expression": "DIVIDE([Revenue YTD] - [Revenue YTD Prior Year], [Revenue YTD Prior Year], BLANK())",
            "formatString": "0.0%",
            "displayFolder": "2 Time Intelligence"
          },
          {
            "name": "Revenue % of Total",
            "expression": "DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED()), 0)",
            "formatString": "0.0%",
            "displayFolder": "3 Dynamic"
          },
          {
            "name": "Product Revenue Rank",
            "expression": [
              "IF(",
              "    HASONEVALUE(dim_product[product_name]),",
              "    RANKX(ALLSELECTED(dim_product[product_name]), [Total Revenue], , DESC, DENSE)",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "3 Dynamic"
          },
          {
            "name": "SubCategory Revenue Rank",
            "expression": [
              "IF(",
              "    HASONEVALUE(dim_product[sub_category]),",
              "    RANKX(ALLSELECTED(dim_product[sub_category]), [Total Revenue], , DESC, DENSE)",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "3 Dynamic"
          },
          {
            "name": "Revenue % of Category",
            "expression": [
              "DIVIDE(",
              "    [Total Revenue],",
              "    CALCULATE([Total Revenue], ALLEXCEPT(dim_product, dim_product[category])),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "3 Dynamic"
          },
          {
            "name": "Profit Margin vs Category Avg",
            "expression": [
              "VAR CurrentMargin = [Profit Margin %]",
              "VAR CategoryAvgMargin =",
              "    CALCULATE([Profit Margin %], ALLEXCEPT(dim_product, dim_product[category]))",
              "RETURN CurrentMargin - CategoryAvgMargin"
            ],
            "formatString": "0.0%",
            "displayFolder": "3 Dynamic"
          },
          {
            "name": "Avg Customer LTV",
            "expression": "AVERAGEX(VALUES(dim_customer[customer_id]), CALCULATE([Total Revenue]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "4 Customer"
          },
          {
            "name": "Revenue per Customer",
            "expression": "DIVIDE([Total Revenue], [Total Customers], 0)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "4 Customer"
          },
          {
            "name": "High Value Revenue %",
            "expression": [
              "DIVIDE(",
              "    CALCULATE([Total Revenue], dim_customer[customer_value_tier] = \"High Value\"),",
              "    [Total Revenue],",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "4 Customer"
          },
          {
            "name": "Loss-Making Orders",
            "expression": "CALCULATE([Total Orders], fact_orders[is_profitable] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "4 Customer"
          },
          {
            "name": "Loss-Making Orders %",
            "expression": "DIVIDE([Loss-Making Orders], [Total Orders], 0)",
            "formatString": "0.0%",
            "displayFolder": "4 Customer"
          },
          {
            "name": "Avg Days to Ship",
            "expression": "AVERAGEX(VALUES(fact_orders[order_id]), CALCULATE(MAX(fact_orders[days_to_ship])))",
            "formatString": "0.0",
            "displayFolder": "4 Customer"
          },
          {
            "name": "New Customers",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT(dim_customer[customer_id]),",
              "    FILTER(",
              "        dim_customer,",
              "        dim_customer[first_order_date] >= MIN(dim_date[Date])",
              "            && dim_customer[first_order_date] <= MAX(dim_date[Date])",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "4 Customer"
          },
          {
            "name": "New Customers %",
            "expression": "DIVIDE([New Customers], [Total Customers], 0)",
            "formatString": "0.0%",
            "displayFolder": "4 Customer"
          },
          {
            "name": "Revenue Lost to Discount",
            "expression": "SUMX(fact_orders, fact_orders[sales] * fact_orders[discount])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "5 Discount"
          },
          {
            "name": "Revenue at Full Price",
            "expression": "SUMX(fact_orders, fact_orders[sales] + (fact_orders[sales] * fact_orders[discount]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "5 Discount"
          },
          {
            "name": "Discount Impact on Profit",
            "expression": "SUMX(fact_orders, fact_orders[sales] * fact_orders[discount] * fact_orders[margin_pct])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "5 Discount"
          },
          {
            "name": "Profit if No Discount",
            "expression": "[Total Profit] - [Discount Impact on Profit]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "5 Discount"
          },
          {
            "name": "Loss-Making Revenue",
            "expression": "CALCULATE([Total Revenue], fact_orders[is_profitable] = FALSE())",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "5 Discount"
          },
          {
            "name": "Weighted Avg Discount",
            "expression": [
              "DIVIDE(",
              "    SUMX(fact_orders, fact_orders[discount] * fact_orders[sales]),",
              "    [Total Revenue],",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "5 Discount"
          },
          {
            "name": "Selected Year Label",
            "expression": [
              "IF(",
              "    HASONEVALUE(dim_date[Year]),",
              "    \"Year \" & SELECTEDVALUE(dim_date[Year]),",
              "    \"All Years\"",
              ")"
            ],
            "displayFolder": "7 Labels"
          },
          {
            "name": "Revenue KPI Status",
            "expression": [
              "VAR Growth = [Revenue YoY %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(Growth),  \"—\",",
              "        Growth >= 0.1,    \"▲ Strong Growth\",",
              "        Growth >= 0,      \"▲ Growth\",",
              "        Growth >= -0.1,   \"▼ Decline\",",
              "        \"▼ Strong Decline\"",
              "    )"
            ],
            "displayFolder": "7 Labels"
          },
          {
            "name": "Profit Margin Status",
            "expression": [
              "VAR Margin = [Profit Margin %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        Margin >= 0.20, \"● Excellent\",",
              "        Margin >= 0.10, \"● Good\",",
              "        Margin >= 0,    \"● Low\",",
              "        \"● Negative\"",
              "    )"
            ],
            "displayFolder": "7 Labels"
          },
          {
            "name": "Simulated Revenue",
            "expression": [
              "SUMX(",
              "    fact_orders,",
              "    VAR OriginalDiscount = fact_orders[discount]",
              "    VAR ReducedDiscount = MAX(0, OriginalDiscount - [Discount Reduction Value])",
              "    VAR OriginalSales = fact_orders[sales]",
              "    VAR SimulatedSales = OriginalSales * (1 + OriginalDiscount) / (1 + ReducedDiscount)",
              "    RETURN SimulatedSales",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "6 What-If"
          },
          {
            "name": "Revenue Uplift",
            "expression": "[Simulated Revenue] - [Total Revenue]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "6 What-If"
          },
          {
            "name": "Simulated Profit Margin %",
            "expression": [
              "VAR SimulatedProfit =",
              "    SUMX(",
              "        fact_orders,",
              "        VAR OriginalDiscount = fact_orders[discount]",
              "        VAR ReducedDiscount = MAX(0, OriginalDiscount - [Discount Reduction Value])",
              "        VAR OriginalSales = fact_orders[sales]",
              "        VAR SimulatedSales = OriginalSales * (1 + OriginalDiscount) / (1 + ReducedDiscount)",
              "        VAR MarginGain = (SimulatedSales - OriginalSales) * fact_orders[margin_pct]",
              "        RETURN fact_orders[profit] + MarginGain",
              "    )",
              "RETURN DIVIDE(SimulatedProfit, [Simulated Revenue], 0)"
            ],
            "formatString": "0.0%",
            "displayFolder": "6 What-If"
          }
        ]
      },
      {
        "name": "Discount Reduction",
        "columns": [
          {
            "name": "Discount Reduction",
            "dataType": "double",
            "formatString": "0.0%",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Discount Reduction",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "GENERATESERIES(0, 0.5, 0.05)"
            }
          }
        ],
        "measures": [
          {
            "name": "Discount Reduction Value",
            "expression": "SELECTEDVALUE('Discount Reduction'[Discount Reduction], 0)",
            "formatString": "0.0%"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "discount_reduction_param"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_date_order",
        "fromTable": "fact_orders",
        "fromColumn": "order_date",
        "toTable": "dim_date",
        "toColumn": "Date"
      },
      {
        "name": "rel_date_ship",
        "fromTable": "fact_orders",
        "fromColumn": "ship_date",
        "toTable": "dim_date",
        "toColumn": "Date",
        "isActive": false
      },
      {
        "name": "rel_customer",
        "fromTable": "fact_orders",
        "fromColumn": "customer_id",
        "toTable": "dim_customer",
        "toColumn": "customer_id"
      },
      {
        "name": "rel_product",
        "fromTable": "fact_orders",
        "fromColumn": "product_id",
        "toTable": "dim_product",
        "toColumn": "product_id"
      },
      {
        "name": "rel_geography",
        "fromTable": "fact_orders",
        "fromColumn": "geo_key",
        "toTable": "dim_geography",
        "toColumn": "geo_key"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"p_DataPath\", \"src_superstore\", \"dim_date\", \"dim_customer\", \"dim_product\", \"dim_geography\", \"fact_orders\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}