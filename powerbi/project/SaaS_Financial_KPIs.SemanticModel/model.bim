            ],
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "dim_geography",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Selected = Table.SelectColumns(src_superstore, {\"Country\", \"Region\", \"State\", \"City\", \"Postal Code\"}),",
                "    Distinct = Table.Distinct(Selected),",
                "    // Surrogate key built the same way in fact_orders, so the join is exact.",
                "    AddKey = Table.AddColumn(Distinct, \"geo_key\",",
                "        each Text.Combine({[Country], [State], [City], [Postal Code]}, \"|\"), type text),",
                "    Renamed = Table.RenameColumns(AddKey, {",
                "        {\"Country\", \"country\"}, {\"Region\", \"region\"},",
                "        {\"State\", \"state\"}, {\"City\", \"city\"}, {\"Postal Code\", \"postal_code\"}})",
                "in",
                "    Renamed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
