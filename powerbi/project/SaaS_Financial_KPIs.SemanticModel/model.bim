        "partitions": [
          {
            "name": "dim_product",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Grouped = Table.Group(",
                "        src_superstore,",
                "        {\"Product ID\"},",
                "        {",
                "            {\"product_name\",  each List.First([Product Name]), type text},",
                "            {\"category\",      each List.First([Category]), type text},",
                "            // #\"...\" is required: a field name with a hyphen is not a valid",
                "            // M identifier, so [Sub-Category] fails to parse.",
                "            {\"sub_category\",  each List.First([#\"Sub-Category\"]), type text},",
                "            {\"total_revenue\", each List.Sum([Sales]), type number},",
                "            {\"total_profit\",  each List.Sum([Profit]), type number}",
                "        }",
                "    ),",
                "    Renamed = Table.RenameColumns(Grouped, {{\"Product ID\", \"product_id\"}}),",
                "    AddMargin = Table.AddColumn(Renamed, \"product_margin_pct\",",
                "        each if [total_revenue] = 0 then 0 else [total_profit] / [total_revenue], type number)",
                "in",
                "    AddMargin"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
