	measure 'Avg Discount' = AVERAGE(fact_orders[discount])
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 99470a36-4ea8-432a-b5a7-94a2e85d1280

	measure 'Revenue YoY %' =
			VAR Y = YEAR(MAX(fact_orders[order_date]))
			VAR Cur = CALCULATE([Total Revenue], FILTER(ALL(dim_date), dim_date[Year] = Y))
			VAR Prev = CALCULATE([Total Revenue], FILTER(ALL(dim_date), dim_date[Year] = Y - 1))
			RETURN
			    IF(ISBLANK(Prev) || Prev = 0, BLANK(), DIVIDE(Cur - Prev, Prev))
		formatString: 0.0%
		displayFolder: 2 Time Intelligence
		lineageTag: b50b19a4-2032-4bb1-8149-099756ce02f6

	measure 'Revenue YoY Abs' =
			VAR Y = YEAR(MAX(fact_orders[order_date]))
			VAR Cur = CALCULATE([Total Revenue], FILTER(ALL(dim_date), dim_date[Year] = Y))
			VAR Prev = CALCULATE([Total Revenue], FILTER(ALL(dim_date), dim_date[Year] = Y - 1))
			RETURN Cur - Prev
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 8a2e3828-5105-4a1b-8e7c-f67148dd5361

	measure 'Revenue Rolling 3M' =
			VAR LastDay = MAX(fact_orders[order_date])
			VAR Y = YEAR(LastDay)
			VAR M = MONTH(LastDay)
			-- janela de 3 meses expressa em AAAAMM, para nao existir mes 0 ou negativo
			VAR StartYM = IF(M >= 3, Y * 100 + M - 2, (Y - 1) * 100 + M + 10)
			RETURN
			    IF(
			        ISBLANK(LastDay),
			        BLANK(),
			        CALCULATE(
			            [Total Revenue],
			            FILTER(
			                ALL(dim_date),
			                dim_date[Year Month Sort] >= StartYM && dim_date[Date] <= LastDay
			            )
			        )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: ceb8c59c-cdd7-4a72-a736-625a2a0fc4dc

	measure 'Revenue YTD' =
			VAR LastDay = MAX(fact_orders[order_date])
			VAR YearStart = DATE(YEAR(LastDay), 1, 1)
			RETURN
			    IF(
			        ISBLANK(LastDay),
			        BLANK(),
			        CALCULATE(
			            [Total Revenue],
			            FILTER(ALL(dim_date), dim_date[Date] >= YearStart && dim_date[Date] <= LastDay)
			        )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 476579b4-bb34-48df-9227-7180b06a2ea7

	measure 'Revenue YTD Prior Year' =
			VAR LastDay = MAX(fact_orders[order_date])
			VAR PriorStart = DATE(YEAR(LastDay) - 1, 1, 1)
			VAR PriorEnd = DATE(YEAR(LastDay) - 1, MONTH(LastDay), DAY(LastDay))
			RETURN
			    IF(
			        ISBLANK(LastDay),
			        BLANK(),
			        CALCULATE(
			            [Total Revenue],
			            FILTER(ALL(dim_date), dim_date[Date] >= PriorStart && dim_date[Date] <= PriorEnd)
			        )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Time Intelligence
		lineageTag: ac34fefb-a329-4070-b390-8211e4e8d88d

	measure 'Revenue YTD vs PY %' = DIVIDE([Revenue YTD] - [Revenue YTD Prior Year], [Revenue YTD Prior Year], BLANK())
		formatString: 0.0%
		displayFolder: 2 Time Intelligence
		lineageTag: b683efae-9d1d-4452-847e-0c21be1b5d6d

	measure 'Revenue % of Total' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED()), 0)
		formatString: 0.0%
		displayFolder: 3 Dynamic
		lineageTag: 38eb76da-1127-41b9-a242-bc63604145c8

	measure 'Product Revenue Rank' =
			IF(
			    HASONEVALUE(dim_product[product_name]),
			    RANKX(ALLSELECTED(dim_product[product_name]), [Total Revenue], , DESC, DENSE)
			)
		formatString: 0
		displayFolder: 3 Dynamic
		lineageTag: 95758ed0-e399-45e9-a3e2-256df13fd334

	measure 'SubCategory Revenue Rank' =
			IF(
			    HASONEVALUE(dim_product[sub_category]),
			    RANKX(ALLSELECTED(dim_product[sub_category]), [Total Revenue], , DESC, DENSE)
			)
		formatString: 0
		displayFolder: 3 Dynamic
		lineageTag: 9b568f13-9961-409c-a7d6-ae435f638219

	measure 'Revenue % of Category' =
			DIVIDE(
			    [Total Revenue],
			    CALCULATE([Total Revenue], ALLEXCEPT(dim_product, dim_product[category])),
			    0
			)
		formatString: 0.0%
		displayFolder: 3 Dynamic
		lineageTag: a833226d-66dc-49b0-a013-fefd1c42d400

	measure 'Profit Margin vs Category Avg' =
			VAR CurrentMargin = [Profit Margin %]
			VAR CategoryAvgMargin =
			    CALCULATE([Profit Margin %], ALLEXCEPT(dim_product, dim_product[category]))
			RETURN CurrentMargin - CategoryAvgMargin
		formatString: 0.0%
		displayFolder: 3 Dynamic
		lineageTag: 273d39f9-d360-4f2d-9bd3-531bdda3ff3a

	measure 'Avg Customer LTV' = AVERAGEX(VALUES(dim_customer[customer_id]), CALCULATE([Total Revenue]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 4 Customer
