		lineageTag: 3eaff2a2-c484-4aee-97af-0fd65fc9a2fd

	measure 'Avg Days to Ship' = AVERAGEX(VALUES(fact_orders[order_id]), CALCULATE(MAX(fact_orders[days_to_ship])))
		formatString: 0.0
		displayFolder: 4 Customer
		lineageTag: 31718f64-1e2a-4826-972d-46a52f214429

	measure 'New Customers' =
			VAR PeriodStart = MIN(dim_date[Date])
			VAR PeriodEnd = MAX(dim_date[Date])
			RETURN
			    IF(
			        ISBLANK(PeriodStart) || ISBLANK(PeriodEnd),
			        BLANK(),
			        CALCULATE(
			            DISTINCTCOUNT(dim_customer[customer_id]),
			            FILTER(
			                ALLSELECTED(dim_customer),
			                dim_customer[first_order_date] >= PeriodStart
			                    && dim_customer[first_order_date] <= PeriodEnd
			            )
			        )
			    )
		formatString: #,0
		displayFolder: 4 Customer
		lineageTag: c5714a1e-fa60-4d26-9e56-683bea7f93d3

	measure 'New Customers %' = DIVIDE([New Customers], [Total Customers], 0)
		formatString: 0.0%
		displayFolder: 4 Customer
		lineageTag: 388fb4bc-16eb-4d07-8d69-c255ea9b2628

	measure 'Revenue Lost to Discount' = SUMX(fact_orders, fact_orders[sales] * fact_orders[discount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Discount
		lineageTag: ecbbb8ef-52f1-4cfb-b73b-db501dc7d33f

	measure 'Revenue at Full Price' = SUMX(fact_orders, fact_orders[sales] + (fact_orders[sales] * fact_orders[discount]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Discount
		lineageTag: 180109de-1ae3-42e5-8d83-a6e897d96b6e

	measure 'Discount Impact on Profit' = SUMX(fact_orders, fact_orders[sales] * fact_orders[discount] * fact_orders[margin_pct])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Discount
		lineageTag: 75a135db-82c2-45d6-b062-e240fc7145ed

	measure 'Profit if No Discount' = [Total Profit] - [Discount Impact on Profit]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Discount
		lineageTag: 1d182864-28f8-4d2c-87e7-8e8da24a14a4

	measure 'Loss-Making Revenue' = CALCULATE([Total Revenue], fact_orders[is_profitable] = FALSE())
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Discount
		lineageTag: b1f5c9f5-0c20-4fd7-99df-470d8b3b8a3b

	measure 'Weighted Avg Discount' =
			DIVIDE(
			    SUMX(fact_orders, fact_orders[discount] * fact_orders[sales]),
			    [Total Revenue],
			    0
			)
		formatString: 0.0%
		displayFolder: 5 Discount
		lineageTag: 097252bc-0328-42c8-b5de-cfa0eac14499

	measure 'Selected Year Label' =
			IF(
			    HASONEVALUE(dim_date[Year]),
			    "Year " & SELECTEDVALUE(dim_date[Year]),
			    "All Years"
			)
		displayFolder: 7 Labels
		lineageTag: e0cc2418-9511-4d86-a8a1-78c671a4e655

	measure 'Revenue KPI Status' =
			VAR Growth = [Revenue YoY %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Growth),  "—",
			        Growth >= 0.1,    "▲ Strong Growth",
			        Growth >= 0,      "▲ Growth",
			        Growth >= -0.1,   "▼ Decline",
			        "▼ Strong Decline"
			    )
		displayFolder: 7 Labels
		lineageTag: 64139b32-1f9d-43cb-9300-e3add10e4827

	measure 'Profit Margin Status' =
			VAR Margin = [Profit Margin %]
			RETURN
			    SWITCH(
			        TRUE(),
			        Margin >= 0.20, "● Excellent",
			        Margin >= 0.10, "● Good",
			        Margin >= 0,    "● Low",
			        "● Negative"
			    )
		displayFolder: 7 Labels
		lineageTag: e94d8694-efe2-431a-a9b7-4e8b537a3d47

	measure 'Dynamic Title' =
			VAR SelectedYear =
			    IF(HASONEVALUE(dim_date[Year]), FORMAT(SELECTEDVALUE(dim_date[Year]), "0"), "All Years")
			VAR SelectedSegment =
			    IF(HASONEVALUE(dim_customer[segment]), SELECTEDVALUE(dim_customer[segment]), "All Segments")
			RETURN
			    "Performance Overview · " & SelectedYear & " · " & SelectedSegment
		displayFolder: 7 Labels
		lineageTag: 3f1c8a70-5d42-4bd6-9a11-27c0f4e91b58

	measure 'Discount Tier Label' =
			IF(
			    HASONEVALUE(fact_orders[discount_tier]),
			    SELECTEDVALUE(fact_orders[discount_tier]),
			    "All Discount Tiers"
			)
		displayFolder: 7 Labels
		lineageTag: 8b24d1e6-0c93-4f57-bd8a-6e5f2a30c714

	measure 'Simulated Revenue' =
			SUMX(
			    fact_orders,
			    VAR OriginalDiscount = fact_orders[discount]
			    VAR ReducedDiscount = MAX(0, OriginalDiscount - [Discount Reduction Value])
			    VAR OriginalSales = fact_orders[sales]
			    VAR SimulatedSales = OriginalSales * (1 + OriginalDiscount) / (1 + ReducedDiscount)
			    RETURN SimulatedSales
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 6 What-If
		lineageTag: cc3e5a21-978c-446a-a68e-1f5ea3251596

	measure 'Revenue Uplift' = [Simulated Revenue] - [Total Revenue]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 6 What-If
		lineageTag: 18d2d596-04c8-46f4-9866-4280c32e129c

	measure 'Simulated Profit Margin %' =
			VAR SimulatedProfit =
			    SUMX(
			        fact_orders,
			        VAR OriginalDiscount = fact_orders[discount]
			        VAR ReducedDiscount = MAX(0, OriginalDiscount - [Discount Reduction Value])
			        VAR OriginalSales = fact_orders[sales]
			        VAR SimulatedSales = OriginalSales * (1 + OriginalDiscount) / (1 + ReducedDiscount)
			        VAR MarginGain = (SimulatedSales - OriginalSales) * fact_orders[margin_pct]
			        RETURN fact_orders[profit] + MarginGain
			    )
			RETURN DIVIDE(SimulatedProfit, [Simulated Revenue], 0)
		formatString: 0.0%
		displayFolder: 6 What-If
		lineageTag: ac0f71ef-a3c7-4c82-9bd2-cd31a502e6b1

