{
  "name": "Superstore Financial KPIs",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "good": "#0ca30c",
  "neutral": "#898781",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#f0efec",
  "minimum": "#cde2fb",
  "null": "#898781",
  "background": "#FCFCFB",
  "secondaryBackground": "#F9F9F7",
  "tableAccent": "#2a78d6",
  "firstLevelElements": "#0b0b0b",
  "secondLevelElements": "#52514e",
  "thirdLevelElements": "#e1e0d9",
  "fourthLevelElements": "#898781",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 32,
      "color": "#0b0b0b"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0b0b0b"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#52514e"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#52514e"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FCFCFB" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e1e0d9" } },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": { "solid": { "color": "#FCFCFB" } },
            "foreground": { "solid": { "color": "#898781" } },
            "transparency": 20
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0b0b0b" } },
            "background": { "solid": { "color": "#FCFCFB" } },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#898781" } },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false,
            "lineColor": { "solid": { "color": "#c3c2b7" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#898781" } },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#e1e0d9" } },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#52514e" } },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#0b0b0b" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineStyle": "solid",
            "showMarker": false
          }
        ],
        "labels": [{ "show": false }]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }],
        "labels": [{ "show": false }]
      }
    },
    "columnChart": {
      "*": {
        "labels": [{ "show": true }]
      }
    },
    "barChart": {
      "*": {
        "labels": [{ "show": true }]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F9F9F7" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e1e0d9" } },
            "radius": 6
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#52514e" } },
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0b0b0b" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#898781" } },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F9F9F7" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F9F9F7" } }
          }
        ]
      }
    }
  }
}
